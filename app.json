{
  "expo": {
    "name": "Htz Phone",
    "slug": "htz-phone",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "htzphone",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.htzphone.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "buildNumber": "7"
    },
    "android": {
      "package": "com.htzphone.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b1220"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}